{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "SavedWorkflow": {
      "properties": {
        "name": {
          "type": "string"
        },
        "objective": {
          "type": "string"
        },
        "taskCount": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "objective",
        "taskCount",
        "title"
      ],
      "type": "object"
    },
    "Workflow": {
      "properties": {
        "blockedTasks": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "completedTasks": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "failedTasks": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "queuedTasks": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "runningTasks": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "status": {
          "$ref": "#/definitions/WorkflowStatus"
        },
        "summary": {
          "type": "string"
        },
        "tasks": {
          "items": {
            "$ref": "#/definitions/WorkflowTask"
          },
          "type": "array"
        },
        "title": {
          "type": "string"
        },
        "workflowId": {
          "type": "string"
        }
      },
      "required": [
        "blockedTasks",
        "completedTasks",
        "failedTasks",
        "queuedTasks",
        "runningTasks",
        "status",
        "summary",
        "tasks",
        "title",
        "workflowId"
      ],
      "type": "object"
    },
    "WorkflowListItem": {
      "oneOf": [
        {
          "properties": {
            "type": {
              "enum": [
                "run"
              ],
              "title": "RunWorkflowListItemType",
              "type": "string"
            },
            "workflow": {
              "$ref": "#/definitions/Workflow"
            }
          },
          "required": [
            "type",
            "workflow"
          ],
          "title": "RunWorkflowListItem",
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "enum": [
                "saved"
              ],
              "title": "SavedWorkflowListItemType",
              "type": "string"
            },
            "workflow": {
              "$ref": "#/definitions/SavedWorkflow"
            }
          },
          "required": [
            "type",
            "workflow"
          ],
          "title": "SavedWorkflowListItem",
          "type": "object"
        }
      ]
    },
    "WorkflowStatus": {
      "enum": [
        "planning",
        "running",
        "pausing",
        "paused",
        "consolidating",
        "completed",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "WorkflowTask": {
      "properties": {
        "attempt": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "status": {
          "$ref": "#/definitions/WorkflowTaskStatus"
        },
        "summary": {
          "type": "string"
        },
        "taskId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "attempt",
        "status",
        "summary",
        "taskId",
        "title"
      ],
      "type": "object"
    },
    "WorkflowTaskStatus": {
      "enum": [
        "queued",
        "ready",
        "running",
        "waitingForApproval",
        "succeeded",
        "failed",
        "blocked",
        "cancelled"
      ],
      "type": "string"
    }
  },
  "properties": {
    "data": {
      "items": {
        "$ref": "#/definitions/WorkflowListItem"
      },
      "type": "array"
    },
    "nextCursor": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "data"
  ],
  "title": "WorkflowListResponse",
  "type": "object"
}